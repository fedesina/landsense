alue": 1}, {"time": 4.071122994652407, "value": 0}]}}}, {"id": "c34", "start": 4.171122994652406, "duration": 4.652406417112299, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t35", "start": 4.221122994652406, "duration": 4.5524064171123, "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "El suelo se corrió medio metro. Nadie lo vio con sus ojos,", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0}, {"time": 0.4, "value": 1}, {"time": 4.152406417112299, "value": 1}, {"time": 4.5524064171123, "value": 0}]}}}, {"id": "c36", "start": 8.823529411764707, "duration": 6.176470588235294, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t37", "start": 8.873529411764707, "duration": 6.076470588235295, "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "pero un radar lo midió desde 747 kilómetros de altura, a través de las nubes.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0}, {"time": 0.4, "value": 1}, {"time": 5.676470588235294, "value": 1}, {"time": 6.076470588235295, "value": 0}]}}}, {"id": "c38", "start": 15, "duration": 6.306306306306307, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t39", "start": 15.05, "duration": 6.206306306306307, "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "Ese radar es NISAR, de NASA y la India. Ve de día y de noche, aunque esté nublado, y vuelve cada 12 días.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0}, {"time": 0.4, "value": 1}, {"time": 5.806306306306307, "value": 1}, {"time": 6.206306306306307, "value": 0}]}}}, {"id": "c40", "start": 21.306306306306308, "duration": 5.465465465465465, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t41", "start": 21.35630630630631, "duration": 5.365465465465466, "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "El problema: sus datos son ecos que casi nadie sabe leer, y un mapa de radar puede engañar.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0}, {"time": 0.4, "value": 1}, {"time": 4.965465465465465, "value": 1}, {"time": 5.365465465465466, "value": 0}]}}}, {"id": "c42", "start": 26.771771771771775, "duration": 5.105105105105105, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t43", "start": 26.821771771771775, "duration": 5.005105105105105, "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "Por eso creamos LandSense: detecta el cambio, lo prueba en fechas donde no pasó nada,", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0}, {"time": 0.4, "value": 1}, {"time": 4.605105105105105, "value": 1}, {"time": 5.005105105105105, "value": 0}]}}}, {"id": "c44", "start": 31.876876876876878, "duration": 3.123123123123123, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t45", "start": 31.92687687687688, "duration": 3.023123123123123, "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "lo confirma con otra fuente y recién ahí lo explica.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0}, {"time": 0.4, "value": 1}, {"time": 2.623123123123123, "value": 1}, {"time": 3.023123123123123, "value": 0}]}}}, {"id": "c46", "start": 35, "duration": 7.894736842105263, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t47", "start": 35.05, "duration": 7.794736842105263, "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "Al sur del aeropuerto de Maiquetía, el suelo se corrió unos 56 centímetros hacia el oeste.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0}, {"time": 0.4, "value": 1}, {"time": 7.394736842105263, "value": 1}, {"time": 7.794736842105263, "value": 0}]}}}, {"id": "c48", "start": 42.89473684210526, "duration": 6.140350877192983, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t49", "start": 42.94473684210526, "duration": 6.040350877192983, "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "NASA informó lo mismo, y dos órbitas distintas del satélite coinciden.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0}, {"time": 0.4, "value": 1}, {"time": 5.640350877192983, "value": 1}, {"time": 6.040350877192983, "value": 0}]}}}, {"id": "c50", "start": 49.03508771929825, "duration": 5.43859649122807, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t51", "start": 49.085087719298244, "duration": 5.338596491228071, "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "Donde el radar ve que todo cambió, marcamos zonas de derrumbe:", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0}, {"time": 0.4, "value": 1}, {"time": 4.93859649122807, "value": 1}, {"time": 5.338596491228071, "value": 0}]}}}, {"id": "c52", "start": 54.473684210526315, "duration": 6.4035087719298245, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t53", "start": 54.52368421052631, "duration": 6.303508771929825, "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "ahí están 248 de los 328 edificios caídos que se relevaron en el terreno.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0}, {"time": 0.4, "value": 1}, {"time": 5.9035087719298245, "value": 1}, {"time": 6.303508771929825, "value": 0}]}}}, {"id": "c54", "start": 60.87719298245614, "duration": 4.12280701754386, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t55", "start": 60.927192982456134, "duration": 4.02280701754386, "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "No reemplaza a nadie: dice dónde mirar primero.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0}, {"time": 0.4, "value": 1}, {"time": 3.62280701754386, "value": 1}, {"time": 4.02280701754386, "value": 0}]}}}, {"id": "c56", "start": 65, "duration": 6.973180076628353, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t57", "start": 65.05, "duration": 6.873180076628353, "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "No elegimos solo los casos lindos. Revisamos los 41 sismos fuertes del planeta desde junio.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0}, {"time": 0.4, "value": 1}, {"time": 6.473180076628353, "value": 1}, {"time": 6.873180076628353, "value": 0}]}}}, {"id": "c58", "start": 71.97318007662835, "duration": 6.053639846743295, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t59", "start": 72.02318007662835, "duration": 5.953639846743295, "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "En 32 el radar no puede medir, porque fueron bajo el mar, y el sistema lo dice.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0}, {"time": 0.4, "value": 1}, {"time": 5.553639846743295, "value": 1}, {"time": 5.953639846743295, "value": 0}]}}}, {"id": "c60", "start": 78.02681992337165, "duration": 6.973180076628353, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t61", "start": 78.07681992337164, "duration": 6.873180076628353, "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "En Panamá y en el Tíbet vio el suelo romperse, y cada hallazgo lleva su color de confianza.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0}, {"time": 0.4, "value": 1}, {"time": 6.473180076628353, "value": 1}, {"time": 6.873180076628353, "value": 0}]}}}, {"id": "c62", "start": 85, "duration": 7.909090909090909, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t63", "start": 85.05, "duration": 7.8090909090909095, "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "El radar también ve el agua. En octubre, durante El Niño, creció el Paraná en el Chaco.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0}, {"time": 0.4, "value": 1}, {"time": 7.409090909090909, "value": 1}, {"time": 7.8090909090909095, "value": 0}]}}}, {"id": "c64", "start": 92.9090909090909, "duration": 5.818181818181818, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t65", "start": 92.9590909090909, "duration": 5.718181818181819, "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "Hicimos una prueba a ciegas: anotamos las reglas antes de mirar.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0}, {"time": 0.4, "value": 1}, {"time": 5.318181818181818, "value": 1}, {"time": 5.718181818181819, "value": 0}]}}}, {"id": "c66", "start": 98.72727272727272, "duration": 6.7272727272727275, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t67", "start": 98.77727272727272, "duration": 6.627272727272728, "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "Cuando el agua tapa las islas, hace de espejo y el eco del radar se apaga.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0}, {"time": 0.4, "value": 1}, {"time": 6.2272727272727275, "value": 1}, {"time": 6.627272727272728, "value": 0}]}}}, {"id": "c68", "start": 105.45454545454545, "duration": 3.727272727272727, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t69", "start": 105.50454545454545, "duration": 3.627272727272727, "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "Los mapas de agua de NASA lo confirmaron:", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0}, {"time": 0.4, "value": 1}, {"time": 3.227272727272727, "value": 1}, {"time": 3.627272727272727, "value": 0}]}}}, {"id": "c70", "start": 109.18181818181819, "duration": 5.818181818181818, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t71", "start": 109.23181818181818, "duration": 5.718181818181819, "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "en las zonas que marcamos, el agua pasó del 13 al 87 por ciento.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0}, {"time": 0.4, "value": 1}, {"time": 5.318181818181818, "value": 1}, {"time": 5.718181818181819, "value": 0}]}}}, {"id": "c72", "start": 115, "duration": 6.033057851239669, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t73", "start": 115.05, "duration": 5.93305785123967, "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "Todo vive en una página web con un globo 3D real, que anda en el celular.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0}, {"time": 0.4, "value": 1}, {"time": 5.533057851239669, "value": 1}, {"time": 5.93305785123967, "value": 0}]}}}, {"id": "c74", "start": 121.03305785123968, "duration": 7.107438016528926, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t75", "start": 121.08305785123967, "duration": 7.007438016528926, "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "Se puede ver de tres formas: para chicos, donde el propio satélite cuenta la historia;", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0}, {"time": 0.4, "value": 1}, {"time": 6.607438016528926, "value": 1}, {"time": 7.007438016528926, "value": 0}]}}}, {"id": "c76", "start": 128.1404958677686, "duration": 6.859504132231405, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t77", "start": 128.19049586776862, "duration": 6.759504132231405, "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "general; y en detalle, para expertos. En español y en inglés, y con código abierto.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0}, {"time": 0.4, "value": 1}, {"time": 6.359504132231405, "value": 1}, {"time": 6.759504132231405, "value": 0}]}}}, {"id": "c78", "start": 135, "duration": 5.553191489361702, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t79", "start": 135.05, "duration": 5.453191489361703, "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "Sirve para que protección civil sepa dónde mirar después de un terremoto o una crecida,", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0}, {"time": 0.4, "value": 1}, {"time": 5.053191489361702, "value": 1}, {"time": 5.453191489361703, "value": 0}]}}}, {"id": "c80", "start": 140.5531914893617, "duration": 3.3191489361702127, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t81", "start": 140.6031914893617, "duration": 3.2191489361702126, "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "para que una escuela entienda qué pasó en su ciudad,", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0}, {"time": 0.4, "value": 1}, {"time": 2.8191489361702127, "value": 1}, {"time": 3.2191489361702126, "value": 0}]}}}, {"id": "c82", "start": 143.87234042553192, "duration": 6.127659574468085, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t83", "start": 143.92234042553193, "duration": 6.027659574468085, "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "y para que periodistas y gobiernos cuenten estos eventos con datos que cualquiera puede revisar.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0}, {"time": 0.4, "value": 1}, {"time": 5.627659574468085, "value": 1}, {"time": 6.027659574468085, "value": 0}]}}}, {"id": "c84", "start": 150, "duration": 4.917218543046357, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t85", "start": 150.05, "duration": 4.817218543046358, "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "Y esto recién empieza. El mismo método ya funciona en cualquier sismo del mundo con un solo código.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0}, {"time": 0.4, "value": 1}, {"time": 4.417218543046357, "value": 1}, {"time": 4.817218543046358, "value": 0}]}}}, {"id": "c86", "start": 154.91721854304635, "duration": 5.562913907284768, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t87", "start": 154.96721854304636, "duration": 5.4629139072847686, "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "Lo próximo: que corra solo en cada pasada, sumar satélites como SAOCOM, de nuestra CONAE, y más tipos de cambio.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0}, {"time": 0.4, "value": 1}, {"time": 5.062913907284768, "value": 1}, {"time": 5.4629139072847686, "value": 0}]}}}, {"id": "c88", "start": 160.48013245033113, "duration": 4.5198675496688745, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t89", "start": 160.53013245033114, "duration": 4.419867549668875, "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "La meta: una plataforma abierta que explique, con datos verificados, cómo cambia la Tierra.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0}, {"time": 0.4, "value": 1}, {"time": 4.0198675496688745, "value": 1}, {"time": 4.419867549668875, "value": 0}]}}}]}
