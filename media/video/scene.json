t": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0, "easing": "ease_out"}, {"time": 0.4, "value": 1}, {"time": 4.1667, "value": 1, "easing": "ease_in"}, {"time": 4.5667, "value": 0}]}}}, {"id": "c36", "start": 8.8333, "duration": 6.1667, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t37", "start": 8.8667, "duration": 6.0667, "timeMode": "layer", "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "pero un radar lo midió desde 747 kilómetros de altura, a través de las nubes.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0, "easing": "ease_out"}, {"time": 0.4, "value": 1}, {"time": 5.6667, "value": 1, "easing": "ease_in"}, {"time": 6.0667, "value": 0}]}}}, {"id": "c38", "start": 15.0, "duration": 6.3, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t39", "start": 15.0667, "duration": 6.2, "timeMode": "layer", "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "Ese radar es NISAR, de NASA y la India. Ve de día y de noche, aunque esté nublado, y vuelve cada 12 días.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0, "easing": "ease_out"}, {"time": 0.4, "value": 1}, {"time": 5.8, "value": 1, "easing": "ease_in"}, {"time": 6.2, "value": 0}]}}}, {"id": "c40", "start": 21.3, "duration": 5.4667, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t41", "start": 21.3667, "duration": 5.3667, "timeMode": "layer", "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "El problema: sus datos son ecos que casi nadie sabe leer, y un mapa de radar puede engañar.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0, "easing": "ease_out"}, {"time": 0.4, "value": 1}, {"time": 4.9667, "value": 1, "easing": "ease_in"}, {"time": 5.3667, "value": 0}]}}}, {"id": "c42", "start": 26.7667, "duration": 5.1, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t43", "start": 26.8333, "duration": 5.0, "timeMode": "layer", "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "Por eso creamos LandSense: detecta el cambio, lo prueba en fechas donde no pasó nada,", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0, "easing": "ease_out"}, {"time": 0.4, "value": 1}, {"time": 4.6, "value": 1, "easing": "ease_in"}, {"time": 5.0, "value": 0}]}}}, {"id": "c44", "start": 31.8667, "duration": 3.1333, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t45", "start": 31.9333, "duration": 3.0333, "timeMode": "layer", "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "lo confirma con otra fuente y recién ahí lo explica.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0, "easing": "ease_out"}, {"time": 0.4, "value": 1}, {"time": 2.6333, "value": 1, "easing": "ease_in"}, {"time": 3.0333, "value": 0}]}}}, {"id": "c46", "start": 35.0, "duration": 7.9, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t47", "start": 35.0667, "duration": 7.8, "timeMode": "layer", "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "Al sur del aeropuerto de Maiquetía, el suelo se corrió unos 56 centímetros hacia el oeste.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0, "easing": "ease_out"}, {"time": 0.4, "value": 1}, {"time": 7.4, "value": 1, "easing": "ease_in"}, {"time": 7.8, "value": 0}]}}}, {"id": "c48", "start": 42.9, "duration": 6.1333, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t49", "start": 42.9333, "duration": 6.0333, "timeMode": "layer", "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "NASA informó lo mismo, y dos órbitas distintas del satélite coinciden.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0, "easing": "ease_out"}, {"time": 0.4, "value": 1}, {"time": 5.6333, "value": 1, "easing": "ease_in"}, {"time": 6.0333, "value": 0}]}}}, {"id": "c50", "start": 49.0333, "duration": 5.4333, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t51", "start": 49.1, "duration": 5.3333, "timeMode": "layer", "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "Donde el radar ve que todo cambió, marcamos zonas de derrumbe:", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0, "easing": "ease_out"}, {"time": 0.4, "value": 1}, {"time": 4.9333, "value": 1, "easing": "ease_in"}, {"time": 5.3333, "value": 0}]}}}, {"id": "c52", "start": 54.4667, "duration": 6.4, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t53", "start": 54.5333, "duration": 6.3, "timeMode": "layer", "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "ahí están 248 de los 328 edificios caídos que se relevaron en el terreno.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0, "easing": "ease_out"}, {"time": 0.4, "value": 1}, {"time": 5.9, "value": 1, "easing": "ease_in"}, {"time": 6.3, "value": 0}]}}}, {"id": "c54", "start": 60.8667, "duration": 4.1333, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t55", "start": 60.9333, "duration": 4.0333, "timeMode": "layer", "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "No reemplaza a nadie: dice dónde mirar primero.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0, "easing": "ease_out"}, {"time": 0.4, "value": 1}, {"time": 3.6333, "value": 1, "easing": "ease_in"}, {"time": 4.0333, "value": 0}]}}}, {"id": "c56", "start": 65.0, "duration": 6.9667, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t57", "start": 65.0667, "duration": 6.8667, "timeMode": "layer", "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "No elegimos solo los casos lindos. Revisamos los 41 sismos fuertes del planeta desde junio.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0, "easing": "ease_out"}, {"time": 0.4, "value": 1}, {"time": 6.4667, "value": 1, "easing": "ease_in"}, {"time": 6.8667, "value": 0}]}}}, {"id": "c58", "start": 71.9667, "duration": 6.0667, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t59", "start": 72.0333, "duration": 5.9667, "timeMode": "layer", "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "En 32 el radar no puede medir, porque fueron bajo el mar, y el sistema lo dice.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0, "easing": "ease_out"}, {"time": 0.4, "value": 1}, {"time": 5.5667, "value": 1, "easing": "ease_in"}, {"time": 5.9667, "value": 0}]}}}, {"id": "c60", "start": 78.0333, "duration": 6.9667, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t61", "start": 78.0667, "duration": 6.8667, "timeMode": "layer", "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "En Panamá y en el Tíbet vio el suelo romperse, y cada hallazgo lleva su color de confianza.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0, "easing": "ease_out"}, {"time": 0.4, "value": 1}, {"time": 6.4667, "value": 1, "easing": "ease_in"}, {"time": 6.8667, "value": 0}]}}}, {"id": "c62", "start": 85.0, "duration": 7.9, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t63", "start": 85.0667, "duration": 7.8, "timeMode": "layer", "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "El radar también ve el agua. En octubre, durante El Niño, creció el Paraná en el Chaco.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0, "easing": "ease_out"}, {"time": 0.4, "value": 1}, {"time": 7.4, "value": 1, "easing": "ease_in"}, {"time": 7.8, "value": 0}]}}}, {"id": "c64", "start": 92.9, "duration": 5.8333, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t65", "start": 92.9667, "duration": 5.7333, "timeMode": "layer", "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "Hicimos una prueba a ciegas: anotamos las reglas antes de mirar.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0, "easing": "ease_out"}, {"time": 0.4, "value": 1}, {"time": 5.3333, "value": 1, "easing": "ease_in"}, {"time": 5.7333, "value": 0}]}}}, {"id": "c66", "start": 98.7333, "duration": 6.7333, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t67", "start": 98.7667, "duration": 6.6333, "timeMode": "layer", "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "Cuando el agua tapa las islas, hace de espejo y el eco del radar se apaga.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0, "easing": "ease_out"}, {"time": 0.4, "value": 1}, {"time": 6.2333, "value": 1, "easing": "ease_in"}, {"time": 6.6333, "value": 0}]}}}, {"id": "c68", "start": 105.4667, "duration": 3.7333, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t69", "start": 105.5, "duration": 3.6333, "timeMode": "layer", "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "Los mapas de agua de NASA lo confirmaron:", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0, "easing": "ease_out"}, {"time": 0.4, "value": 1}, {"time": 3.2333, "value": 1, "easing": "ease_in"}, {"time": 3.6333, "value": 0}]}}}, {"id": "c70", "start": 109.1667, "duration": 5.8333, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t71", "start": 109.2333, "duration": 5.7333, "timeMode": "layer", "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "en las zonas que marcamos, el agua pasó del 13 al 87 por ciento.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0, "easing": "ease_out"}, {"time": 0.4, "value": 1}, {"time": 5.3333, "value": 1, "easing": "ease_in"}, {"time": 5.7333, "value": 0}]}}}, {"id": "c72", "start": 115.0, "duration": 6.0333, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t73", "start": 115.0667, "duration": 5.9333, "timeMode": "layer", "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "Todo vive en una página web con un globo 3D real, que anda en el celular.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0, "easing": "ease_out"}, {"time": 0.4, "value": 1}, {"time": 5.5333, "value": 1, "easing": "ease_in"}, {"time": 5.9333, "value": 0}]}}}, {"id": "c74", "start": 121.0333, "duration": 7.1, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t75", "start": 121.0667, "duration": 7.0, "timeMode": "layer", "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "Se puede ver de tres formas: para chicos, donde el propio satélite cuenta la historia;", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0, "easing": "ease_out"}, {"time": 0.4, "value": 1}, {"time": 6.6, "value": 1, "easing": "ease_in"}, {"time": 7.0, "value": 0}]}}}, {"id": "c76", "start": 128.1333, "duration": 6.8667, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t77", "start": 128.2, "duration": 6.7667, "timeMode": "layer", "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "general; y en detalle, para expertos. En español y en inglés, y con código abierto.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0, "easing": "ease_out"}, {"time": 0.4, "value": 1}, {"time": 6.3667, "value": 1, "easing": "ease_in"}, {"time": 6.7667, "value": 0}]}}}, {"id": "c78", "start": 135.0, "duration": 5.5667, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t79", "start": 135.0667, "duration": 5.4667, "timeMode": "layer", "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "Sirve para que protección civil sepa dónde mirar después de un terremoto o una crecida,", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0, "easing": "ease_out"}, {"time": 0.4, "value": 1}, {"time": 5.0667, "value": 1, "easing": "ease_in"}, {"time": 5.4667, "value": 0}]}}}, {"id": "c80", "start": 140.5667, "duration": 3.3333, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t81", "start": 140.6, "duration": 3.2333, "timeMode": "layer", "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "para que una escuela entienda qué pasó en su ciudad,", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0, "easing": "ease_out"}, {"time": 0.4, "value": 1}, {"time": 2.8333, "value": 1, "easing": "ease_in"}, {"time": 3.2333, "value": 0}]}}}, {"id": "c82", "start": 143.8667, "duration": 6.1333, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t83", "start": 143.9333, "duration": 6.0333, "timeMode": "layer", "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "y para que periodistas y gobiernos cuenten estos eventos con datos que cualquiera puede revisar.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0, "easing": "ease_out"}, {"time": 0.4, "value": 1}, {"time": 5.6333, "value": 1, "easing": "ease_in"}, {"time": 6.0333, "value": 0}]}}}, {"id": "c84", "start": 150.0, "duration": 4.9333, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t85", "start": 150.0667, "duration": 4.8333, "timeMode": "layer", "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "Y esto recién empieza. El mismo método ya funciona en cualquier sismo del mundo con un solo código.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0, "easing": "ease_out"}, {"time": 0.4, "value": 1}, {"time": 4.4333, "value": 1, "easing": "ease_in"}, {"time": 4.8333, "value": 0}]}}}, {"id": "c86", "start": 154.9333, "duration": 5.5667, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t87", "start": 154.9667, "duration": 5.4667, "timeMode": "layer", "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "Lo próximo: que corra solo en cada pasada, sumar satélites como SAOCOM, de nuestra CONAE, y más tipos de cambio.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0, "easing": "ease_out"}, {"time": 0.4, "value": 1}, {"time": 5.0667, "value": 1, "easing": "ease_in"}, {"time": 5.4667, "value": 0}]}}}, {"id": "c88", "start": 160.4667, "duration": 4.5333, "transform": {"position": [960.0, 985], "opacity": 0.62}, "content": {"kind": "color", "color": "#000000", "size": [1920, 130]}}, {"id": "t89", "start": 160.5333, "duration": 4.4333, "timeMode": "layer", "transform": {"position": [960.0, 960]}, "content": {"kind": "text", "text": "La meta: una plataforma abierta que explique, con datos verificados, cómo cambia la Tierra.", "font": {"family": "f_reg", "size": 38}, "color": "#FFFFFF", "alignment": "center", "wrapWidth": 1700}, "animations": {"opacity": {"keyframes": [{"time": 0, "value": 0, "easing": "ease_out"}, {"time": 0.4, "value": 1}, {"time": 4.0333, "value": 1, "easing": "ease_in"}, {"time": 4.4333, "value": 0}]}}}]}
